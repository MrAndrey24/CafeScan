import kotlin.Boolean;

CREATE TABLE Product (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    price REAL NOT NULL,
    stock INTEGER NOT NULL
);

CREATE TABLE Sale (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    productId INTEGER NOT NULL,
    quantity INTEGER NOT NULL,
    totalAmount REAL NOT NULL,
    timestamp INTEGER NOT NULL,
    FOREIGN KEY (productId) REFERENCES Product(id)
);

-- Product Queries
insertProduct:
INSERT INTO Product (name, price, stock)
VALUES (?, ?, ?);

updateProduct:
UPDATE Product
SET name = ?, price = ?, stock = ?
WHERE id = ?;

deleteProduct:
DELETE FROM Product
WHERE id = ?;

selectAllProducts:
SELECT * FROM Product;

selectProductById:
SELECT * FROM Product
WHERE id = ?;

updateStock:
UPDATE Product
SET stock = stock - ?
WHERE id = ?;

-- Sale Queries
insertSale:
INSERT INTO Sale (productId, quantity, totalAmount, timestamp)
VALUES (?, ?, ?, ?);

selectAllSales:
SELECT * FROM Sale;

selectSalesWithProduct:
SELECT 
    Sale.*,
    Product.name AS productName
FROM Sale
JOIN Product ON Sale.productId = Product.id;

selectSalesByProductId:
SELECT * FROM Sale
WHERE productId = ?;